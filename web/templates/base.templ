package templates

templ Base(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
			<title>{ title } - Planning</title>
			<link rel="icon" type="image/png" sizes="32x32" href="/static/images/logo.png"/>
			<link rel="stylesheet" href="/static/css/style.css"/>
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			<script src="https://unpkg.com/htmx.org/dist/ext/json-enc.js"></script>
			<script>
				// Redirect to login on 401 errors
				document.addEventListener('htmx:responseError', function(evt) {
					if (evt.detail.xhr.status === 401) {
						window.location.href = '/login';
					}
				});
			</script>
		</head>
		<body>
			@content
		</body>
	</html>
}

templ AppShell(path string, content templ.Component) {
	<div class="app-container" id="app-container">
		@Header()
		<div class="content" id="content">
			@content
		</div>
		@BottomNav(path)
	</div>
}

templ Header() {
	<div class="app-header">
		<h1 class="app-title">
			<img src="/static/images/logo.png" alt="Logo" class="app-logo"/>
			Planning
		</h1>
	</div>
}

templ BottomNav(path string) {
	<div class="bottom-nav" id="bottom-nav">
		<a href="/home" class={ "nav-item", templ.KV("active", path == "/home") } hx-target="#content" hx-push-url="true">
			if path == "/home" {
				<svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor">
					<path d="M11.47 3.841a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.061l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.689Z" />
					<path d="m12 5.432 8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198a2.29 2.29 0 0 0 .091-.086L12 5.432Z" />
				</svg>
			} else {
				<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
				</svg>
			}
			<span class="nav-label">Home</span>
		</a>
		<a href="/rooms" class={ "nav-item", templ.KV("active", path == "/rooms") } hx-target="#content" hx-push-url="true">
			if path == "/rooms" {
				<svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor">
					<path d="M5.566 4.657A4.505 4.505 0 0 1 6.75 4.5h10.5c.41 0 .806.055 1.183.157A3 3 0 0 0 15.75 3h-7.5a3 3 0 0 0-2.684 1.657ZM2.25 12a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3v-6ZM5.25 7.5c-.41 0-.806.055-1.184.157A3 3 0 0 1 6.75 6h10.5a3 3 0 0 1 2.683 1.657A4.505 4.505 0 0 0 18.75 7.5H5.25Z" />
				</svg>
			} else {
				<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 18 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 0 0 4.5 9v.878m13.5-3A2.25 2.25 0 0 1 19.5 9v.878m0 0a2.246 2.246 0 0 0-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0 1 21 12v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6c0-.98.626-1.813 1.5-2.122" />
				</svg>
			}
			<span class="nav-label">Rooms</span>
		</a>
		<a href="/create" class={ "nav-item", templ.KV("active", path == "/create") } hx-target="#content" hx-push-url="true">
			if path == "/create" {
				<svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor">
					<path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z" clip-rule="evenodd" />
				</svg>
			} else {
				<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
				</svg>
			}
			<span class="nav-label">Create</span>
		</a>
		<a href="/profile" class={ "nav-item", templ.KV("active", path == "/profile") } hx-target="#content" hx-push-url="true">
			if path == "/profile" {
				<svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor">
					<path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653Zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438ZM15.75 9a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" clip-rule="evenodd" />
				</svg>
			} else {
				<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
				</svg>
			}
			<span class="nav-label">Profile</span>
		</a>
	</div>
}

templ Dialog(title string, content templ.Component) {
	<div class="dialog-overlay" onclick="this.remove()">
		<div class="dialog" onclick="event.stopPropagation()">
			<div class="dialog-title">{ title }</div>
			<div class="dialog-content">
				@content
			</div>
		</div>
	</div>
}

templ LoadingSpinner() {
	<div class="loading-spinner">
		<svg width="24" height="24" viewBox="0 0 24 24">
			<circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
			<path d="M12 2a10 10 0 0 1 10 10" fill="none" stroke="currentColor" stroke-width="2"/>
			<animateTransform attributeName="transform" type="rotate" dur="1s" repeatCount="indefinite" values="0 12 12;360 12 12"/>
		</svg>
	</div>
}
