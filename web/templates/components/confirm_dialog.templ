package components

script hideDialogScript(id string) {
	hideDialog(id);
}

script confirmActionScript(id string) {
	confirmAction(id);
}

templ ConfirmDialog(id string, title string, message string, confirmText string, cancelText string, confirmClass ...string) {
	<div class="dialog-overlay" id={ "dialog-" + id } style="display: none;" onclick={ hideDialogScript(id) }>
		<div class="dialog" onclick="event.stopPropagation()">
			<div class="dialog-title">{ title }</div>
			<div class="dialog-content">
				<p>{ message }</p>
			</div>
			<div class="dialog-actions">
				<button class="dialog-btn secondary" type="button" onclick={ hideDialogScript(id) }>{ cancelText }</button>
				<button class="dialog-btn primary" type="button" onclick={ confirmActionScript(id) }>{ confirmText }</button>
			</div>
		</div>
	</div>
}
