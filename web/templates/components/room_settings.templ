package components

import "awesomeProject1/internal/dto"

templ RoomSettingsDrawer(roomID string, room dto.RoomResponse) {
	<div class="drawer-overlay" onclick="this.remove()">
		<div class="drawer open" onclick="event.stopPropagation()">
			<div class="drawer-handle"></div>
			<div class="drawer-content">
				<div class="drawer-title">Room Settings</div>
				
				@RoomInfoSection(roomID, room)
				@DangerZone(roomID)
			</div>
		</div>
	</div>
}

templ RoomInfoSection(roomID string, room dto.RoomResponse) {
	<div class="settings-section">
		<h3 class="settings-section-title">Room Information</h3>
		
		<form hx-put={ "/api/rooms/" + roomID }
			  hx-encoding="multipart/form-data"
			  hx-target="#room-update-result"
			  hx-swap="innerHTML">
			
			<div id="room-update-result"></div>
			
			<label class="form-label">Room Name</label>
			<input type="text" name="name" class="form-input" value={ room.Name } required/>
			
			<label class="form-label">Room Image (optional)</label>
			<div class="file-input-wrapper" id="settings-file-wrapper">
				<input type="file" name="room_image" class="form-input file-input-modern" accept="image/*" onchange="updateSettingsFileInput(this)"/>
				<div class="file-input-hint">
					<svg class="file-upload-icon" viewBox="0 0 24 24" fill="currentColor">
						<path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" />
					</svg>
					<span class="file-input-text" id="settings-file-text">Choose an image or drag and drop</span>
				</div>
			</div>
			
			<script>
				function updateSettingsFileInput(input) {
					const wrapper = document.getElementById('settings-file-wrapper');
					const textElement = document.getElementById('settings-file-text');
					
					if (input.files && input.files[0]) {
						const fileName = input.files[0].name;
						textElement.textContent = fileName;
						wrapper.classList.add('has-file');
					} else {
						textElement.textContent = 'Choose an image or drag and drop';
						wrapper.classList.remove('has-file');
					}
				}
			</script>
			

			
			<button type="submit" class="primary-btn">
				Update Room
			</button>
		</form>
	</div>
}



templ DangerZone(roomID string) {
	<div class="settings-section danger-zone">
		<button class="danger-btn" type="button" onclick="showDialog('delete-room')">
			Delete Room
		</button>
	</div>

	@ConfirmDialog("delete-room", "Delete Room", "Are you sure you want to delete this room? This action cannot be undone.", "Delete", "Cancel")

	<script>
		// Store roomID for use in confirmAction
		window.currentRoomID = '{ roomID }';

		function confirmAction(id) {
			if (id === 'delete-room') {
				fetch('/api/rooms/' + window.currentRoomID, {
					method: 'DELETE',
					credentials: 'include'
				})
			.then(response => {
				if (response.ok) {
					showToast('Room deleted successfully!', 'success');
					setTimeout(() => {
						window.location.href = '/rooms';
					}, 1500);
				} else {
					return response.json().then(data => {
						throw new Error(data.error || 'Failed to delete room');
					});
				}
			})
			.catch(error => {
				showToast(error.message, 'error');
			})
			.finally(() => {
				hideDialog('delete-room');
			});
		}
	</script>
}

templ RoomUpdateSuccess() {
	<div class="success-message-small">✅ Room updated successfully</div>
}

templ RoomUpdateError(message string) {
	<div class="error-message-small">❌ { message }</div>
}

templ DeleteConfirmationDialog(roomID string) {
	<div class="dialog-overlay" id={ "delete-dialog-" + roomID } style="display: none;" onclick="hideDeleteDialog('{ roomID }')">
		<div class="dialog" onclick="event.stopPropagation()">
			<div class="dialog-title">Delete Room</div>
			<div class="dialog-content">
				<p>Are you sure you want to delete this room? This action cannot be undone.</p>
			</div>
			<div class="dialog-actions">
				<button class="dialog-btn secondary" onclick="hideDeleteDialog('{ roomID }')">Cancel</button>
				<button class="dialog-btn primary" onclick="confirmDeleteRoom('{ roomID }')">Delete</button>
			</div>
		</div>
	</div>
}
