package pages

templ CreateRoomPage() {
	<div class="section active" id="create-section">
		<div class="section-title">Create New Room</div>
		@CreateRoomForm()
	</div>
}

templ CreateRoomForm() {
	<div class="create-form">
		<form hx-post="/api/rooms" 
			  hx-encoding="multipart/form-data"
			  hx-target="#create-result"
			  hx-swap="innerHTML"
			  hx-on::before-request="document.getElementById('create-btn').disabled = true; document.getElementById('create-btn').textContent = 'Creating...'"
			  hx-on::after-request="document.getElementById('create-btn').disabled = false; document.getElementById('create-btn').textContent = 'Create Room'">
			
			<div id="create-result"></div>
			
			<label for="room-name" class="form-label">Room Name</label>
			<input
				type="text"
				name="name"
				id="room-name"
				class="form-input"
				placeholder="Sprint Planning Session"
				required
				maxlength="50"
			/>

			<label for="room-image" class="form-label">Room Image (optional)</label>
			<div class="file-input-wrapper" id="file-wrapper">
				<input
					type="file"
					name="room_image"
					id="room-image"
					class="form-input file-input-modern"
					accept="image/*"
					onchange="updateFileInput(this)"
				/>
				<div class="file-input-hint">
					<svg class="file-upload-icon" viewBox="0 0 24 24" fill="currentColor">
						<path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" />
					</svg>
					<span class="file-input-text" id="file-text">Choose an image or drag and drop</span>
				</div>
			</div>
			
			<script>
				function updateFileInput(input) {
					const wrapper = document.getElementById('file-wrapper');
					const textElement = document.getElementById('file-text');
					
					if (input.files && input.files[0]) {
						const fileName = input.files[0].name;
						textElement.textContent = fileName;
						wrapper.classList.add('has-file');
					} else {
						textElement.textContent = 'Choose an image or drag and drop';
						wrapper.classList.remove('has-file');
					}
				}
			</script>

			<button type="submit" class="primary-btn" id="create-btn">
				Create Room
			</button>
		</form>
	</div>
}

templ CreateRoomSuccess(roomID string, roomName string) {
	<div class="success-message">
		<div class="success-icon">✅</div>
		<div class="success-title">Room Created!</div>
		<div class="success-subtitle">{ roomName } is ready for planning</div>
		<div class="success-subtitle">Redirecting to room...</div>
		<div class="success-actions">
			<button class="primary-btn" 
					hx-get={ "/rooms/" + roomID }
					hx-target="body"
					hx-swap="innerHTML">
				Enter Room Now
			</button>
		</div>
	</div>
	<script>
		// Auto-redirect to room after 2 seconds
		setTimeout(() => {
			htmx.ajax('GET', '/rooms/{ roomID }', {target: 'body', swap: 'innerHTML'});
		}, 2000);
	</script>
}

templ CreateRoomError(message string) {
	<div class="error">{ message }</div>
}