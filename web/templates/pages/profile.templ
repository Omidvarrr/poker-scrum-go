package pages

import "awesomeProject1/internal/dto"
import "awesomeProject1/web/templates/components"

templ ProfilePage(profile dto.ProfileResponse) {
	<div class="section active" id="profile-section">
		<div class="section-title">Profile</div>
		@ProfileInfo(profile)
		@ProfileActions()
	</div>
}

templ ProfileInfo(profile dto.ProfileResponse) {
	<div class="profile-info-clean">
		<div class="profile-avatar">
			if profile.Avatar != "" {
				<img src={ profile.Avatar } alt="Profile Avatar" class="profile-avatar-img"/>
			} else {
				<div class="profile-avatar-placeholder">
					if len(profile.FirstName) > 0 {
						{ string(profile.FirstName[0]) }
					} else {
						?
					}
				</div>
			}
		</div>

		<div class="profile-details">
			<div class="profile-name" id="profile-name">{ profile.FirstName + " " + profile.LastName }</div>
			<div class="profile-email" id="profile-email">{ profile.Email }</div>
		</div>
	</div>
}

templ ProfileActions() {
	<div class="profile-actions">
		<button class="secondary-btn logout-btn" type="button">
			Logout
		</button>
	</div>

	@components.ConfirmDialog("logout", "Confirm Logout", "Are you sure you want to logout?", "Logout", "Cancel", "danger")

	<script>
		document.addEventListener('click', function(e) {
			if (e.target.closest('.logout-btn')) {
				showDialog('logout');
			}
		});

		// Override global functions for profile page
		window.showDialog = function(id) {
			document.getElementById('dialog-' + id).style.display = 'flex';
		}

		window.hideDialog = function(id) {
			document.getElementById('dialog-' + id).style.display = 'none';
		}

		window.confirmAction = function(id) {
			if (id === 'logout') {
				fetch('/api/auth/logout', {method: 'POST', credentials: 'include'})
					.then(() => window.location.href = '/login')
					.catch(() => window.location.href = '/login');
			}
		}
	</script>
}
